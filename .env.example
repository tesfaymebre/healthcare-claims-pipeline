# Database (required)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# REST API (optional). When set, every /api/v1 request needs X-API-Key.
API_KEY=

# Alerting (optional; enable the channel in config/settings.yaml)
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Lineage (optional; used when lineage.transport is http, e.g. Marquez)
OPENLINEAGE_URL=
